EXPO_PUBLIC_RORK_API_BASE_URL=http://localhost:3000
# Mirrors DEV_LOGIN but exposed to the client bundle (EXPO_PUBLIC_* only) so the
# Profile screen can show "Switch test user". Keep in sync with DEV_LOGIN below.
EXPO_PUBLIC_DEV_LOGIN=1
DATABASE_URL=
DEV_LOGIN=1
ALLOWED_EMAIL_DOMAINS=arizona.edu,demo.campus.test
PORT=3000
PLATFORM_FEE_PERCENT=10
# Comma-separated user ids with basic moderation access (review reports).
# Defaults to Maya's fixed demo id so the pilot has a responsible operator to
# review reports out of the box.
MODERATOR_USER_IDS=00000000-0000-4000-8000-000000000001
# Custom meetup address geocoding (backend/geocode.ts). Leave unset to use the
# real OpenStreetMap Nominatim service (fine for local dev/pilot volume, not
# for production traffic — see docs/HANDOFF.md). Set to "stub" for a
# deterministic offline fixture used by scripts/geo-check.ts.
# GEOCODER=stub

# ---------------------------------------------------------------- payments
# simulated | test | live. Default (and what this repo runs in): simulated.
# If STRIPE_SECRET_KEY below is empty the server FORCES simulated no matter
# what this says, and every payment screen shows "Simulated — no money moves."
PAYMENTS_MODE=simulated
# Your Stripe secret key. THESE ARE YOURS TO CREATE AND YOURS TO KEEP SECRET.
# Never commit a real key — put it in .env (gitignored), never in this file.
# Test keys start sk_test_, live keys start sk_live_.
STRIPE_SECRET_KEY=
# From the Stripe dashboard when you add the webhook endpoint
# (POST <your server>/api/stripe/webhook). Starts whsec_.
STRIPE_WEBHOOK_SECRET=
# Deliberate second switch: PAYMENTS_MODE=live is ignored unless this is 1, so
# real money cannot be turned on by changing one variable by accident.
STRIPE_LIVE_ACK=
# Public base URL Stripe sends sellers back to after Connect onboarding.
# Defaults to http://localhost:$PORT, which is fine for local testing only.
PUBLIC_APP_URL=
# How long Stripe holds a seller's money before paying it out to their bank.
# Whole number of days, 0-30. Applied as settings.payouts.schedule.delay_days
# when the seller's Express account is created (0 is sent to Stripe as its
# "minimum", because Stripe enforces a country floor — 2 days in the US).
#
# READ THIS BEFORE LEAVING IT AT 0. Payments now run as DIRECT CHARGES: the
# sale is taken on the seller's own Stripe account, so a disputed payment is
# taken back out of the SELLER's Stripe balance. At 0 the seller has usually
# already been paid out, there is no balance left to take it from, Stripe puts
# them negative, and if the seller never makes that good the loss lands back
# on the platform under Stripe's negative-balance rules. A delay keeps a
# buffer sitting in the seller's balance for exactly that case.
#
# 0  = pay the seller as fast as Stripe allows (this repo's default)
# 7  = recommended for the pilot
PAYOUT_DELAY_DAYS=0

# ------------------------------------------------------------- object storage
# Leave S3_BUCKET empty to keep writing photos to local disk
# (backend/data/uploads) exactly as today — nothing below is required for
# local dev. Set S3_BUCKET to switch to S3-compatible storage; when you do,
# S3_REGION, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY become required and the
# server refuses to start without them (backend/env.ts validateS3Env). Works
# against AWS S3 or any S3-compatible provider (Cloudflare R2, Backblaze B2,
# Wasabi, ...) — see docs/DEPLOY.md for how to pick one and fill these in.
S3_BUCKET=
S3_REGION=
# Only needed for a non-AWS provider (R2, B2, Wasabi, MinIO, ...). Leave empty
# for real AWS S3.
S3_ENDPOINT=
# THESE ARE SECRETS. Never commit real values — put them in .env (gitignored),
# never in this file.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. When set, uploaded photo URLs point straight at this base URL
# (a public bucket URL or a CDN/custom domain in front of the bucket) instead
# of being proxied through the backend at GET /api/uploads/:name. See the
# S3Storage docstring in backend/storage.ts for the tradeoff.
S3_PUBLIC_BASE_URL=

# --------------------------------------------------------------- production
# development | production. Controls CORS strictness only (see backend/hono.ts).
# Leave unset locally — the Expo Go / LAN workflow needs permissive CORS.
NODE_ENV=development
# Comma-separated list of origins allowed to call the API. Only enforced when
# NODE_ENV=production; ignored in development. Example:
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# ----------------------------------------------------------- rate limiting
# Per-IP, per-minute request limits enforced by backend/ratelimit.ts (an
# in-memory limiter — see that file's docstring for why it does not scale to
# multiple instances). Sane defaults are built in; override only if needed.
# RATE_LIMIT_AUTH_REQUEST_CODE_PER_MIN=5
# RATE_LIMIT_AUTH_VERIFY_CODE_PER_MIN=10
# RATE_LIMIT_CHECK_ADDRESS_PER_MIN=12
# RATE_LIMIT_UPLOADS_PER_MIN=20
