EXPO_PUBLIC_RORK_API_BASE_URL=http://localhost:3000
# The public HTTPS origin of the deployed website — used by the web share
# feature (utils/shareListing.ts) so that share links point at the real site
# rather than localhost. Set this to your final deployed URL, e.g.:
#   EXPO_PUBLIC_WEB_BASE_URL=https://trydibbs.com
# This value is baked into the web bundle at build time (EXPO_PUBLIC_* are
# evaluated by Metro at build, not at runtime), so if you change it you must
# rebuild the site. When unset, the code falls back to window.location.origin,
# which is correct for local dev and preview deploys — you only need this var
# for the production build.
EXPO_PUBLIC_WEB_BASE_URL=
# Inbox for the "Email your video" button shown after posting a listing (it opens
# the person's mail app; nothing is uploaded). Defaults to hello@trydibbs.com, the
# founder inbox; no dedicated video inbox exists yet, so confirm before launch.
# EXPO_PUBLIC_VIDEO_EMAIL=
# Mirrors DEV_LOGIN but exposed to the client bundle (EXPO_PUBLIC_* only) so the
# Profile screen can show "Switch test user". Keep in sync with DEV_LOGIN below.
EXPO_PUBLIC_DEV_LOGIN=1
DATABASE_URL=
DEV_LOGIN=1
ALLOWED_EMAIL_DOMAINS=arizona.edu,demo.campus.test
PORT=3000
# In-app payment is OFF: no fee, no pay step, buyers pay sellers in person.
# Set PAYMENTS_ENABLED=1 (and PLATFORM_FEE_PERCENT) only to bring the dormant
# Stripe flow back. An unpaid booked meetup is never cancelled while this is off.
PAYMENTS_ENABLED=0
PLATFORM_FEE_PERCENT=0
# Comma-separated user ids with basic moderation access (review reports).
# Defaults to Maya's fixed demo id so the pilot has a responsible operator to
# review reports out of the box.
MODERATOR_USER_IDS=00000000-0000-4000-8000-000000000001
# Custom meetup address geocoding (backend/geocode.ts). Leave unset to use the
# real OpenStreetMap Nominatim service (fine for local dev/pilot volume, not
# for production traffic — see docs/HANDOFF.md). Set to "stub" for a
# deterministic offline fixture used by scripts/geo-check.ts.
# GEOCODER=stub

# ---------------------------------------------------------------- payments
# simulated | test | live. Default (and what this repo runs in): simulated.
# If STRIPE_SECRET_KEY below is empty the server FORCES simulated no matter
# what this says, and every payment screen shows "Simulated — no money moves."
PAYMENTS_MODE=simulated
# Your Stripe secret key. THESE ARE YOURS TO CREATE AND YOURS TO KEEP SECRET.
# Never commit a real key — put it in .env (gitignored), never in this file.
# Test keys start sk_test_, live keys start sk_live_.
STRIPE_SECRET_KEY=
# From the Stripe dashboard when you add the webhook endpoint
# (POST <your server>/api/stripe/webhook). Starts whsec_.
STRIPE_WEBHOOK_SECRET=
# Deliberate second switch: PAYMENTS_MODE=live is ignored unless this is 1, so
# real money cannot be turned on by changing one variable by accident.
STRIPE_LIVE_ACK=
# Public base URL Stripe sends sellers back to after Connect onboarding.
# Defaults to http://localhost:$PORT, which is fine for local testing only.
PUBLIC_APP_URL=
# How long Stripe holds a seller's money before paying it out to their bank.
# Whole number of days, 0-30. Applied as settings.payouts.schedule.delay_days
# when the seller's Express account is created (0 is sent to Stripe as its
# "minimum", because Stripe enforces a country floor — 2 days in the US).
#
# READ THIS BEFORE LEAVING IT AT 0. Payments now run as DIRECT CHARGES: the
# sale is taken on the seller's own Stripe account, so a disputed payment is
# taken back out of the SELLER's Stripe balance. At 0 the seller has usually
# already been paid out, there is no balance left to take it from, Stripe puts
# them negative, and if the seller never makes that good the loss lands back
# on the platform under Stripe's negative-balance rules. A delay keeps a
# buffer sitting in the seller's balance for exactly that case.
#
# 0  = pay the seller as fast as Stripe allows (this repo's default)
# 7  = recommended for the pilot
PAYOUT_DELAY_DAYS=0

# ------------------------------------------------------------- object storage
# Leave S3_BUCKET empty to keep writing photos to local disk
# (backend/data/uploads) exactly as today — nothing below is required for
# local dev. Set S3_BUCKET to switch to S3-compatible storage; when you do,
# S3_REGION, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY become required and the
# server refuses to start without them (backend/env.ts validateS3Env). Works
# against AWS S3 or any S3-compatible provider (Cloudflare R2, Backblaze B2,
# Wasabi, ...) — see docs/DEPLOY.md for how to pick one and fill these in.
S3_BUCKET=
S3_REGION=
# Only needed for a non-AWS provider (R2, B2, Wasabi, MinIO, ...). Leave empty
# for real AWS S3.
S3_ENDPOINT=
# THESE ARE SECRETS. Never commit real values — put them in .env (gitignored),
# never in this file.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. When set, uploaded photo URLs point straight at this base URL
# (a public bucket URL or a CDN/custom domain in front of the bucket) instead
# of being proxied through the backend at GET /api/uploads/:name. See the
# S3Storage docstring in backend/storage.ts for the tradeoff.
S3_PUBLIC_BASE_URL=

# --------------------------------------------------------------- production
# development | production. Controls CORS strictness only (see backend/hono.ts).
# Leave unset locally — the Expo Go / LAN workflow needs permissive CORS.
NODE_ENV=development
# Comma-separated list of origins allowed to call the API. Only enforced when
# NODE_ENV=production; ignored in development. Example:
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# ----------------------------------------------------------- rate limiting
# Per-minute request limits enforced by backend/ratelimit.ts (an in-memory
# limiter — see that file's docstring for why it does not scale to multiple
# instances). Sane defaults are built in; override only if needed.
#
# RATE_LIMIT_API_PER_MIN is the ceiling on the whole tRPC surface. It is keyed
# by session for signed-in callers and by IP only for anonymous ones, because
# a few hundred students on campus wifi share one NAT address and a per-IP cap
# would throttle the building. A busy browse session is well under 100/min.
# The IP is Cloudflare's CF-Connecting-IP (cannot be faked by the client),
# falling back to X-Forwarded-For. Sign-in code limits are per IP and sized for
# a campus wifi; each email address also has its own cooldown and hourly cap.
# Uploads require sign-in and are limited per person.
# RATE_LIMIT_API_PER_MIN=300
# RATE_LIMIT_API_ANON_PER_MIN=1500
# RATE_LIMIT_AUTH_REQUEST_CODE_PER_MIN=30
# RATE_LIMIT_AUTH_VERIFY_CODE_PER_MIN=60
# RATE_LIMIT_CHECK_ADDRESS_PER_MIN=12
# RATE_LIMIT_UPLOADS_PER_MIN=30

# ------------------------------------------------------ postgres connections
# Only used when DATABASE_URL is set. Defaults are built in.
#
# DB_POOL_MAX is per backend process. What matters is the database's own
# connection limit divided by how many copies of the backend you run — a hobby
# tier is often ~20 connections in total, so two instances at 10 each already
# use them all.
# DB_POOL_MAX=10
#
# How long a request waits for a free connection before giving up. The library
# default is "wait forever", which turns a slow database into a backend that
# stops answering at all instead of returning an error.
# DB_CONNECTION_TIMEOUT_MS=5000
#
# Postgres-enforced ceiling on one statement, so a single pathological query
# cannot hold a pooled connection indefinitely.
# DB_STATEMENT_TIMEOUT_MS=10000

# ------------------------------------------------------ transactional SMS
# Phone sign-in codes and three event texts (listing posted, booking
# confirmed, 30-minute reminder) go through backend/sms/. Everything here is
# OPTIONAL and the default is SIMULATED: nothing is sent, a masked line is
# logged, and sign-in codes are printed to the server log.
#
# WARNING: LIVE SENDS TEXT REAL PHONES AND COST MONEY. They happen only when
# SMS_MODE=live AND TWILIO_ACCOUNT_SID AND TWILIO_AUTH_TOKEN AND TWILIO_FROM
# are all set AND SMS_LIVE_ACK=1. Missing any one falls back to simulated.
# NEVER set these in development or on a laptop. Tests (NODE_ENV=test) always
# simulate, whatever is set here. Before going live read "Transactional SMS
# (Twilio)" in docs/DEPLOY.md (US texting needs A2P 10DLC or toll-free
# verification first). Keep the Twilio secrets in the host's secret store,
# never in this file.
# SMS_MODE=simulated
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Sender: a Twilio phone number in E.164 (+1...) or a Messaging Service SID (MG...).
# TWILIO_FROM=
# Second, deliberate switch so one variable can't text real people. Set to 1 only in production.
# SMS_LIVE_ACK=
# How often the in-process dispatcher looks for due texts. Default 30000 (30s); 0 turns it off.
# SMS_DISPATCH_INTERVAL_MS=30000
# Base URL used for links inside texts (e.g. https://dibbs.yourdomain.com).
# Falls back to EXPO_PUBLIC_WEB_BASE_URL, then to a dibbs:// link.
# SMS_APP_LINK_BASE=
# Per-minute limits on phone sign-in endpoints (defaults 5 and 10). These sit on
# top of the per-number rules in the code (30s cooldown, 5 codes/hour, 5 guesses).
# RATE_LIMIT_PHONE_REQUEST_PER_MIN=5
# RATE_LIMIT_PHONE_VERIFY_PER_MIN=10

# ------------------------------------------------ listing autofill AI (Claude)
# The Sell form's "Fill in details from photos" button reads the seller's photos
# and drafts title, category, condition, brand, description and a price range.
# Code: backend/ai/listing-draft.ts.
# ANTHROPIC_API_KEY is the only switch: set it and autofill is live. With no key
# the button returns a fixed demo draft labeled as a demo (no network call).
# Set LISTING_AI_MODE=simulated to force the demo draft even when a key exists.
# Tests (NODE_ENV=test) always simulate, whatever is set here.
# Each live draft is one Claude API call with up to 4 photos. Each user is capped
# at 15 drafts per hour (in-memory, per server instance).
# Keep the key in the host's secret store, never in this file. It is server-only
# (not EXPO_PUBLIC_), so it never reaches the app.
# LISTING_AI_MODE=simulated
# ANTHROPIC_API_KEY=
# Optional model override. Default claude-sonnet-5-5 (claude-opus-5-5 is more
# capable and costs more; claude-haiku-5-5 is cheaper).
# LISTING_AI_MODEL=claude-sonnet-5-5

# ------------------------------------------------------ sign-in email (Resend)
# Email sign-in codes go through backend/email/. Everything here is OPTIONAL and
# the default is SIMULATED: nothing is sent, and the code is printed to the
# server log. Live email needs ALL THREE of EMAIL_MODE=live, RESEND_API_KEY and
# EMAIL_FROM. Missing any one falls back to simulated. Tests (NODE_ENV=test)
# always simulate, whatever is set here. Live mode never writes codes to the log.
# The sending domain in EMAIL_FROM must be verified in Resend first (add the SPF
# and DKIM DNS records Resend shows you). Set these on the deployed backend only.
# Setup steps: "Sign-in email (Resend) — set up first" in docs/DEPLOY.md.
# EMAIL_MODE=simulated
# Resend API key. Keep it in the host's secret store, never in this file.
# RESEND_API_KEY=
# Sender, e.g. Dibbs <codes@trydibbs.com>. The domain must be verified in Resend.
# EMAIL_FROM=

# ------------------------------------------------------- founder dashboard
# Password for the dashboard at <your API URL>/admin (e.g.
# https://api.trydibbs.com/admin). Unset, or under 16 characters, turns the
# dashboard off entirely (404). Set it ONLY in the host's secret store.
# Signing in keeps that browser signed in indefinitely; CHANGING THIS VALUE
# SIGNS OUT EVERY BROWSER, which is how you revoke a lost device.
# Generate one with: openssl rand -base64 24
ADMIN_PASSWORD=

# Exact public HTTPS URL configured as Twilio incoming-message POST webhook.
# Enable Advanced Opt-Out on the Messaging Service. Never use a client-provided host.
TWILIO_INBOUND_WEBHOOK_URL=
