  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend": "tsx watch backend/server.ts",
    "backend:once": "tsx backend/server.ts",
    "db:seed": "tsx backend/db/seed.ts",
    "db:reset": "tsx backend/db/guard.ts && rm -rf backend/data/pg && tsx backend/db/seed.ts",
    "db:check": "tsx scripts/check-db-url.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "env:lan": "node -e \"const fs=require('fs');const ip=require('child_process').execSync('ipconfig getifaddr en0').toString().trim();let e=fs.readFileSync('.env','utf8');e=e.replace(/EXPO_PUBLIC_RORK_API_BASE_URL=.*/,'EXPO_PUBLIC_RORK_API_BASE_URL=http://'+ip+':3000');fs.writeFileSync('.env',e);console.log('API base URL set to http://'+ip+':3000')\""
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true
  }
}
